### aliases
function _auth_key_fingerprint() {
  setopt local_options pipe_fail no_xtrace
  gpg --batch --with-colons --import-options show-only --import \
    | awk -F: '
        $1 == "pub" || $1 == "sec" { primary=1; count++; next }
        $1 == "fpr" && primary { fingerprint=$10; primary=0 }
        END { if (count == 1 && fingerprint != "") print fingerprint; else exit 1 }
      '
}

function _auth_cache_gpg_key() {
  setopt local_options pipe_fail no_xtrace
  local fingerprint="$1" item_uri="$2"
  local libexec_dir preset_passphrase key_data keygrips keygrip

  libexec_dir="$(gpgconf --list-dirs libexecdir)" || return 1
  preset_passphrase="${libexec_dir}/gpg-preset-passphrase"
  if [[ ! -x "$preset_passphrase" ]]; then
    print -u2 -- "gpg-preset-passphrase not found at ${preset_passphrase}."
    return 1
  fi

  key_data="$(gpg --batch --with-colons --with-keygrip --list-secret-keys "$fingerprint")" || return 1
  keygrips="$(print -r -- "$key_data" | awk -F: '
    $1 == "sec" || $1 == "ssb" { available=($15 == "+") }
    $1 == "grp" && available { print $10 }
  ')" || return 1
  if [[ -z "$keygrips" ]]; then
    print -u2 -- "No local secret key material found for ${fingerprint}."
    return 1
  fi

  for keygrip in ${(f)keygrips}; do
    pass-cli item view "${item_uri}/passphrase" \
      | "$preset_passphrase" --preset "$keygrip" || return 1
  done
}

function _auth_load_gpg_key() {
  setopt local_options pipe_fail no_xtrace
  local vault_name="$1" key_name="$2"
  local item_uri="pass://${vault_name}/${key_name}"
  local key_id public_key private_key fingerprint private_fingerprint

  key_id="$(pass-cli item view "${item_uri}/ID")" || return 1
  key_id="${(U)key_id}"
  key_id="${key_id#0X}"
  if [[ "$key_id" == *[^0-9A-F]* ]] || \
      (( ${#key_id} != 16 && ${#key_id} != 40 && ${#key_id} != 64 )); then
    print -u2 -- "${key_name}: ID must be a full primary fingerprint or 16-digit key ID."
    return 1
  fi

  public_key="$(pass-cli item view "${item_uri}/public_key")" || return 1
  fingerprint="$(print -r -- "$public_key" | _auth_key_fingerprint)" || return 1
  if [[ "$fingerprint" != "$key_id" && \
        ! ( ${#key_id} == 16 && "$fingerprint" == *"$key_id" ) ]]; then
    print -u2 -- "${key_name}: public key does not match its ID."
    return 1
  fi

  private_key="$(pass-cli item view "${item_uri}/private_key")" || return 1
  private_fingerprint="$(print -r -- "$private_key" | _auth_key_fingerprint)" || return 1
  if [[ "$private_fingerprint" != "$fingerprint" ]]; then
    print -u2 -- "${key_name}: private and public keys do not match."
    return 1
  fi

  print -r -- "$public_key" | gpg --batch --import || return 1
  print -r -- "$private_key" | gpg --batch --import || return 1
  private_key=

  _auth_cache_gpg_key "$fingerprint" "$item_uri" || return 1

  if ! print -r -- 'dotfiles auth signing check' \
      | gpg --batch --yes --pinentry-mode error --local-user "$fingerprint" \
          --output /dev/null --detach-sign; then
    print -u2 -- "${key_name}: signing check failed; verify the key and passphrase in Proton Pass."
    return 1
  fi

  print -r -- "${fingerprint}:6:" | gpg --batch --import-ownertrust || return 1
  print -r -- "${key_name} ready."
}

function _auth_ssh_agent() {
  local agent_env
  agent_env="$(keychain agent start --quiet --no-inherit --eval --host "${SHORT_HOST:-${(%):-%m}}")" || return 1
  eval "$agent_env"
}

function auth() {
  setopt local_options no_xtrace
  local key_type="${1:-personal}" result=0 dependency

  if (( $# > 1 )); then
    print -u2 -- "Usage: auth [personal|moser|fssa|iga]"
    return 2
  fi

  case "$key_type" in
    personal|moser|fssa|iga) ;;
    *)
      print -u2 -- "Unknown key type: $key_type"
      print -u2 -- "Usage: auth [personal|moser|fssa|iga]"
      return 2
      ;;
  esac

  for dependency in pass-cli keychain ssh-add gpg gpgconf; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
      print -u2 -- "Missing ${dependency}; run brew bundle --file=\"$HOME/.Brewfile\"."
      return 1
    fi
  done

  _auth_ssh_agent || return 1
  gpgconf --launch gpg-agent || return 1

  if ! pass-cli info >/dev/null; then
    pass-cli login || return 1
  fi

  if ! pass-cli session lock; then
    pass-cli session create-lock || return 1
  fi

  {
    if pass-cli session unlock; then
      case "$key_type" in
        personal)
          pass-cli ssh-agent load --vault-name "Personal" || result=1
          _auth_load_gpg_key "Personal" "Personal GPG Key" || result=1
          ;;
        moser|fssa|iga)
          pass-cli ssh-agent load --vault-name "Moser Consulting" || result=1
          case "$key_type" in
            moser) _auth_load_gpg_key "Moser Consulting" "Moser GPG Key" || result=1 ;;
            fssa) _auth_load_gpg_key "Moser Consulting" "FSSA GPG Key" || result=1 ;;
            iga) _auth_load_gpg_key "Moser Consulting" "IGA GPG Key" || result=1 ;;
          esac
          ;;
      esac
    else
      result=1
    fi
  } always {
    pass-cli session lock || result=1
  }

  if (( result == 0 )); then
    print -r -- "${key_type} credentials loaded; Proton Pass is locked."
  else
    print -u2 -- "Authentication was incomplete; some keys may already be loaded."
  fi
  return $result
}

function auth-lock() {
  local result=0
  if _auth_ssh_agent; then
    ssh-add -D || result=1
  else
    result=1
  fi
  gpgconf --reload gpg-agent || result=1
  pass-cli session lock || result=1
  return $result
}

function findpkg() {
  local dir
  dir=$(realpath "${2:-.}")
  grep -rn "\"$1\"" --include="package.json" \
    --exclude-dir=node_modules \
    --exclude-dir=dist \
    --exclude-dir=.next \
    --exclude-dir=.nuxt \
    --exclude-dir=.output \
    --exclude-dir=build \
    --exclude-dir=out \
    "$dir" \
    | sed -E 's|(.+):.*"([^"]+)": *"([^"]+)".*|\1\t\2\t\3|' \
    | sort \
    | while IFS=$'\t' read -r file_path pkg ver; do
      echo -e "\033[36m$file_path\033[0m → \033[32m$pkg\033[0m@\033[33m$ver\033[0m"
      done
}

function update() {
  echo '\e[32m\ue5fc chezmoi'
  chezmoi update --apply

  echo '\e[32m\ue795 antidote'
  antidote update

  if command -v apt &> /dev/null; then
    echo '\e[32m\ue77d apt'
    sudo apt update && sudo apt upgrade
  fi

  if command -v dnf &> /dev/null; then
    echo '\e[32m\ue7d9 dnf'
    sudo dnf upgrade
  fi

  if command -v pacman &> /dev/null; then
    if command -v paru &> /dev/null; then
      echo '\e[32m\ue732 paru'
      paru -Syu
    else
      echo '\e[32m\ue732 pacman'
      sudo pacman -Syu
    fi
  fi

  if command -v flatpak &> /dev/null; then
    echo '\e[32m\uf1b2 flatpak'
    sudo flatpak update --system -y && flatpak update --user -y
  fi

  if command -v mas &> /dev/null; then
    echo '\e[32m\ue711 mas'
    mas upgrade
  fi

  echo '\e[32m\uf0fc brew'
  brew update && brew upgrade -y && brew upgrade -y --cask

  echo '\e[32m\uf1b2 mise'
  mise upgrade && mise prune -y
}

function cleanup() {
  if command -v apt &> /dev/null; then
    echo '\e[32m\ue77d apt'
    sudo apt autoremove --purge
  fi

  if command -v dnf &> /dev/null; then
    echo '\e[32m\ue7d9 dnf'
    sudo dnf autoremove
  fi

  if command -v pacman &> /dev/null; then
    if command -v paru &> /dev/null; then
      echo '\e[32m\ue732 paru'
      paru -Rsn $(paru -Qtdq)
    else
      echo '\e[32m\uf303 pacman'
      sudo pacman -Rns $(pacman -Qtdq)
    fi

    paccache -r
  fi

  if command -v flatpak &> /dev/null; then
    echo '\e[32m\uf1b2 flatpak'
    flatpak uninstall --unused -y
  fi

  if command -v docker &> /dev/null; then
    echo '\e[32m\ue7b0 docker'
    docker system prune -f
  fi

  echo '\e[32m\uf0fc brew'
  brew cleanup

  echo '\e[32m\uf1b2 mise'
  mise prune -y
}

alias bump='bunx taze@latest -rwiI --exclude node,pnpm'
alias bumpall='bunx taze@latest major -rwilI'
alias c='clear'
alias dotfiles='chezmoi edit'
alias ls='eza -al --color=always --group-directories-first --icons=always' # preferred listing
alias la='eza -a --color=always --group-directories-first --icons=always'  # all files and dirs
alias ll='eza -l --color=always --group-directories-first --icons=always'  # long format
alias lt='eza -aT --color=always --group-directories-first --icons=always' # tree listing
alias l.="eza -a | grep -e '^\.'"                                          # show only dotfiles
alias lint='bunx oxlint@latest --tsconfig tsconfig.json --import-plugin --jsdoc-plugin --vitest-plugin --react-perf-plugin --promise-plugin --node-plugin --vue-plugin'
alias fmt='bunx oxfmt@latest'
alias inspect='bunx fallow@latest'
alias git-truck='bunx git-truck@latest'
