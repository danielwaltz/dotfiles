{{- $config := includeTemplate "profile-data" . | fromJson -}}
#!/usr/bin/env zsh

emulate -L zsh
setopt errexit nounset pipe_fail

readonly profiles_dir={{ joinPath .chezmoi.destDir ".config/git/chezmoi-profiles" | shellQuote }}
readonly marker='# Generated by chezmoi client profiles. Do not edit.'
readonly -a profile_ids=(
{{- range $id := $config.git_profiles }}
  {{ $id | shellQuote }}
{{- end }}
)

function is_generated_profile() {
  [[ -f "$1" && ! -L "$1" ]] || return 1
  local first_line
  IFS= read -r first_line < "$1" || return 1
  [[ "$first_line" == "$marker" ]]
}

if [[ -L "$profiles_dir" ]]; then
  print -u2 -r -- "Refusing to write Git profiles through a symlink: ${profiles_dir}"
  exit 1
fi
command mkdir -p -- "$profiles_dir"

# Check all destinations before replacing any files.
for profile in "${profile_ids[@]}"; do
  target="${profiles_dir}/${profile}.gitconfig"
  if [[ -e "$target" || -L "$target" ]] && ! is_generated_profile "$target"; then
    print -u2 -r -- "Refusing to replace a Git profile not owned by this generator: ${target}"
    exit 1
  fi
done

staging_dir=$(mktemp -d "${profiles_dir}/.staging.XXXXXX")
trap 'command rm -rf -- "$staging_dir"' EXIT

{{ range $id := $config.git_profiles -}}
print -rn -- {{ includeTemplate "profile-gitconfig" (get $config.profiles $id) | shellQuote }} > "$staging_dir/{{ $id }}.gitconfig"
{{ end }}
for profile in "${profile_ids[@]}"; do
  target="${profiles_dir}/${profile}.gitconfig"
  if ! command cmp -s -- "$staging_dir/${profile}.gitconfig" "$target"; then
    command mv -f -- "$staging_dir/${profile}.gitconfig" "$target"
  fi
done

# Leave unrelated files alone, including symlinks and files without our marker.
for target in "$profiles_dir"/*.gitconfig(N); do
  profile="${${target:t}%.gitconfig}"
  if (( ${profile_ids[(Ie)$profile]} == 0 )) && is_generated_profile "$target"; then
    command rm -- "$target"
  fi
done
