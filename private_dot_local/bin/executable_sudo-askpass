#!/usr/bin/env zsh
#
# sudo-askpass — read the sudo password for the current machine.
#
# Ladder (first success wins). Diagnostics always go to stderr; on success
# stdout contains only the password (the askpass contract).
#
#   1. pass-cli — resolved from PATH, then from static install locations
#      (Homebrew arm64/x86_64, Linuxbrew, manual). A candidate must be
#      executable and respond to --version (a foreign binary at that path
#      must not win).
#        * item view succeeds   -> emit the password
#        * session locked       -> prompt for the lock code on the tty,
#                                 `session unlock`, re-read
#        * session signed out   -> default (web) `login`: opens the browser
#                                 and blocks until the sign-in completes
#                                 (nothing is ever typed on the tty, the
#                                 browser handles authentication), capped by
#                                 a timeout. On success, sets up a session
#                                 lock (`session create-lock`) so future
#                                 access requires the lock code (TTY case
#                                 only).
#        * other error / re-auth fail -> fall through to step 2
#   2. per-machine keychain item via the `security` CLI (capability probe
#      only; no OS detection; no-ops when `security` or the item is absent)
#   3. sudo password prompt on /dev/tty
#
# Exit 0 with the password on stdout, 1 otherwise. Prompts never block:
# when no terminal is available, report an error and fall through.
#
# SUDO_PASS_STRICT=1: hard-fail (exit 1) the instant pass-cli is available
# but cannot supply the password, skipping the keychain/terminal fallbacks.
#
# Standalone: no oh-my-zsh dependency. $HOME/.config/dotfiles/sudo.zsh,
# generated by dot_config/dotfiles/sudo.zsh.tmpl, provides the per-host
# vault mapping.

emulate -L zsh
setopt no_xtrace no_verbose

# ---- configuration ------------------------------------------------------

readonly config_file="$HOME/.config/dotfiles/sudo.zsh"
if [[ ! -r $config_file ]]; then
  print -u2 -r -- "Missing sudo configuration: $config_file. Run chezmoi apply."
  exit 1
fi
source "$config_file" || exit 1

# Lookups are keyed by the stable hostname resolved from chezmoi data
# (_dotfiles_stable_host, defined in the sourced sudo.zsh). The live
# hostname changes with the tailscale connection and must not be used as
# a key.

if ! secret_uri="$(_dotfiles_sudo_secret_uri)"; then
  print -u2 -r -- 'Could not determine the sudo password item.'
  exit 1
fi

password=''
strict=0
if [[ -n ${SUDO_PASS_STRICT-} ]]; then
  strict=1
fi
pass_cli_found=0

# ---- tty handling -------------------------------------------------------

tty_fd=-1

open_tty() {
  (( tty_fd >= 0 )) && return 0
  if exec {tty_fd}<>/dev/tty 2>/dev/null; then
    return 0
  fi
  return 1
}

close_tty() {
  if (( tty_fd >= 0 )); then
    stty echo <&$tty_fd 2>/dev/null
    exec {tty_fd}>&-
    tty_fd=-1
  fi
}

# ---- classification (capability probe only: grep, no OS detection) ------

# Does text $1 match ERE $2, case-insensitively? Quiet; never writes stdout.
matches_ci() {
  command grep -qiIE -- "$2" <<< "$1"
}

is_session_locked() {
  matches_ci "$1" 'sessionlocked|session locked|is locked|lock code'
}

is_signed_out() {
  matches_ci "$1" 'no active session|there is no session|no session|signed out|not signed in|not logged in|requires an authenticated client|pass-cli login|authentication required|session expired|unauthenticated|invalid session'
}

validate_password() {
  [[ -n $1 ]] || return 1
  [[ $1 == *$'\n'* ]] && return 1
  [[ $1 == *$'\r'* ]] && return 1
  return 0
}

# ---- terminal prompt -----------------------------------------------------

# Prompt for the sudo password on /dev/tty (no echo). On success sets $pass
# word and returns 0; otherwise returns 1.
prompt_system_password() {
  local pass ret

  if ! open_tty; then
    print -u2 -r -- 'No terminal available; cannot prompt for the sudo password.'
    return 1
  fi

  printf 'sudo password: ' >&$tty_fd
  stty -echo <&$tty_fd 2>/dev/null
  IFS= read -r -s pass <&$tty_fd
  ret=$?
  stty echo <&$tty_fd 2>/dev/null
  printf '\n' >&$tty_fd
  close_tty

  if (( ret == 0 )) && [[ -n $pass ]]; then
    password="$pass"
    return 0
  fi
  return 1
}

# ---- pass-cli -------------------------------------------------------------

pass_cli=''

# Resolve pass-cli. sudo may reset PATH, so also probe static install
# locations. A candidate is accepted only if it is executable and responds
# to --version.
resolve_pass_cli() {
  local candidate

  for candidate in \
    "$(command -v pass-cli 2>/dev/null)" \
    "${HOMEBREW_PREFIX:-}/bin/pass-cli" \
    /opt/homebrew/bin/pass-cli \
    /usr/local/bin/pass-cli \
    "$HOME/.local/bin/pass-cli" \
    "$HOME/.linuxbrew/bin/pass-cli" \
    /home/linuxbrew/.linuxbrew/bin/pass-cli
  do
    [[ -n $candidate && -x $candidate ]] || continue
    "$candidate" --version >/dev/null 2>&1 || continue
    pass_cli="$candidate"
    return 0
  done
  return 1
}

read_pass_cli_item() {
  local ret=0
  password=''
  password="$(command "$pass_cli" item view "$secret_uri" 2>"$error_file")"
  ret=$?
  return $ret
}

# ---- bounded execution ----------------------------------------------------

# run_bounded TIMEOUT...CMD — execute CMD with a bounded wait so a hung
# process (e.g. a pending browser sign-in) cannot block sudo indefinitely.
# Returns CMD's exit code, or 124 on timeout. No coreutils/gtimeout
# dependency; polls a background job each second.
run_bounded() {
  local timeout_seconds remaining pid rc

  timeout_seconds="$1"
  shift

  "$@" &
  pid=$!
  remaining=$timeout_seconds
  while (( remaining > 0 )); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null
      return $?
    fi
    sleep 1
    (( remaining-- ))
  done
  kill "$pid" 2>/dev/null
  command pkill -TERM -P "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null
  return 124
}

# ---- keychain (capability probe only; no OS detection) -------------------

# Per-machine service name for the keychain backup item.
keychain_service_name() {
  local host
  host="$(_dotfiles_stable_host)"
  [[ $host =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || return 1
  print -r -- "dotfiles.sudo.$host"
}

# Write the current password into the per-machine keychain item (lazy seed:
# only when `security` exists and no readable item is present). The item
# value is passed via stdin so it never appears in the process list. On
# macOS `security` may show a one-time-per-session keychain prompt.
keychain_seed() {
  local svc
  svc="$(keychain_service_name)" || return
  command -v security >/dev/null 2>&1 || return
  # Skip re-seeding when a readable item already exists.
  command security find-generic-password -s "$svc" -w >/dev/null 2>&1 && return
  local rc
  printf '%s\n' "$password" | command security add-generic-password -s "$svc" -i >/dev/null 2>&1
  rc=$?
  if (( rc != 0 )); then
    print -u2 -r -- "sudo-askpass: keychain seed failed (security add-generic-password, exit $rc)."
  fi
}

# Read the password from the per-machine keychain item. On success sets
# password and returns 0.
keychain_read() {
  local svc pw
  svc="$(keychain_service_name)" || return 1
  command -v security >/dev/null 2>&1 || return 1
  pw="$(command security find-generic-password -s "$svc" -w 2>/dev/null)"
  if validate_password "$pw"; then
    password="$pw"
    return 0
  fi
  return 1
}

# ---- pass-cli flow --------------------------------------------------------

# Return 0 when password is set via pass-cli (with lazy keychain seeding);
# otherwise return 1. error_file holds the most recent stderr output.
get_password_from_pass_cli() {
  local err recovered=0

  error_file="$(command mktemp "${TMPDIR:-/tmp}/sudo-askpass-error.XXXXXXXX")" || return 1
  trap 'command rm -f -- "$error_file"' EXIT

  if read_pass_cli_item; then
    if validate_password "$password"; then
      keychain_seed
      return 0
    fi
    print -u2 -r -- "Proton Pass returned an empty password for $secret_uri."
    return 1
  fi

  if (( strict )); then
    return 1
  fi

  err="$(<"$error_file")"
  err="${(L)err}"

  if is_session_locked "$err" || is_signed_out "$err"; then
    if is_session_locked "$err"; then
      if open_tty; then
        recovered=1
        print -u "$tty_fd" -r -- 'Proton Pass is locked. Enter the lock code:'
        stty -echo <&$tty_fd 2>/dev/null
        command "$pass_cli" session unlock <&$tty_fd >&$tty_fd 2>&1
        close_tty
      else
        print -u2 -r -- 'No terminal to unlock the locked Pass session; falling back.'
      fi
    else
      # Signed out: run the default (web) sign-in. It opens the browser and
      # blocks until the sign-in completes; nothing is typed on the tty.
      if open_tty; then
        recovered=1
        print -u "$tty_fd" -- 'Proton Pass is signed out. Signing in via browser; complete the sign-in in your browser.'
        # Attach login output to the tty so it is visible. Stdin is /dev/null
        # so no accidental interactive prompt.
        if [[ -n $pass_cli ]]; then
          run_bounded 300 "$pass_cli" login </dev/null >&$tty_fd 2>&1
        fi
        # Set up a session lock so future access requires the lock code.
        # Bounded to 60s so a distracted user does not block sudo forever.
        if [[ -n $pass_cli ]]; then
          run_bounded 60 "$pass_cli" session create-lock </dev/null >&$tty_fd 2>&1
        fi
        close_tty
      else
        recovered=1
        print -u2 -r -- 'Proton Pass is signed out; attempting browser sign-in without a terminal.'
        if [[ -n $pass_cli ]]; then
          # stdout is the askpass password pipe, so discard login output;
          # stderr falls through to the caller (usually the sudo stderr).
          run_bounded 300 "$pass_cli" login </dev/null >/dev/null
        fi
      fi
    fi
  else
    # Unrecognized pass-cli error: dump the full stderr text (stderr only;
    # error text never contains the password) so the caller's transcript shows
    # the actual root cause, e.g. "Reason: <...>" from the Caused-by chain.
    print -u2 -r -- "sudo-askpass: pass-cli item view failed (falling back). Full error:"
    print -u2 -r -- "$err"
  fi

  if (( recovered )); then
    if read_pass_cli_item && validate_password "$password"; then
      keychain_seed
      return 0
    fi
  fi
  return 1
}

# ---- main ------------------------------------------------------------------

if resolve_pass_cli; then
  pass_cli_found=1
  get_password_from_pass_cli
fi

if [[ -z $password ]]; then
  if (( pass_cli_found && strict )); then
    print -u2 -r -- 'Proton Pass is available but could not provide the sudo password (SUDO_PASS_STRICT=1).'
    exit 1
  fi

  # Keychain backup (capability-probed; no-op on machines without `security`
  # or without the item).
  keychain_read
  if [[ -z $password ]]; then
    print -u2 -r -- 'sudo-askpass: pass-cli and keychain unavailable; falling back to terminal sudo-password prompt.'
    prompt_system_password || exit 1
  fi
fi

if ! validate_password "$password"; then
  print -u2 -r -- 'The configured sudo password must be a nonempty single line.'
  exit 1
fi
print -r -- "$password"
