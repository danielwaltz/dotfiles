#!/usr/bin/env zsh
#
# sudo-askpass-shim: sudo shim for non-interactive callers (AUR helpers like
# `paru` and `yay`). Those helpers exec `sudo` directly, bypassing the
# interactive zsh `sudo()` function, so plain `sudo` would fall back to a
# terminal password prompt.
#
# This shim re-enters the dotfiles askpass path: it adds -A so sudo reads the
# password via $SUDO_ASKPASS (sudo-askpass -> Proton Pass).
#
# If $SUDO_ASKPASS is not set (integration disabled in this environment), it
# falls back to plain sudo. As with the zsh function, an explicitly supplied
# authentication option is respected and the call is passed through unchanged.
#
# Syntax stays compatible with bash 3.2+ and zsh: no exec of shell builtins,
# no bash-only indirect positional expansion.

set -u

# Only use the askpass path when the integration is active for the caller.
if [[ -n "${SUDO_ASKPASS-}" ]]; then
  # Same option scan as the zsh sudo() function: bail out when the caller
  # passes an explicit authentication flag, and skip values so the words
  # following a value-taking option are not mistaken for sudo options.
  # (bash arrays are 0-based; zsh arrays are 1-based.)
  args=("$@")
  n=$#
  suboff=0
  if [[ -n "${BASH_VERSION-}" ]]; then
    suboff=1
  fi
  idx=1
  while (( idx <= n )); do
    opt="${args[$((idx-suboff))]}"
    case "$opt" in
      --askpass|--stdin|--non-interactive)
        command sudo "$@"
        exit $?
        ;;
      --auth-type|--close-from|--login-class|--chdir|--group|--host|--prompt|--chroot|--role|--command-timeout|--type|--other-user|--user)
        (( idx += 2 )); continue
        ;;
      --) break ;;
      --*) (( idx++ )); continue ;;
      -?*)
        flags="${opt#-}"
        for (( position = 1; position <= ${#flags}; position++ )); do
          flag="${flags:position-1:1}"
          case "$flag" in
            A|S|n)
              command sudo "$@"
              exit $?
              ;;
            a|C|c|D|g|h|p|R|r|T|t|U|u)
              # A value can follow the option directly or be the next argument.
              (( position < ${#flags} )) || (( idx++ ))
              break
              ;;
          esac
        done
        ;;
      *) break ;;
    esac
    (( idx++ ))
  done

  command sudo -A "$@"
  exit $?
fi

command sudo "$@"
exit $?
