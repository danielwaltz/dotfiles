#!/usr/bin/env zsh

emulate -L zsh
setopt pipe_fail no_xtrace

readonly ICON_ERROR=$'\xef\x81\x97'
readonly ICON_KEY=$'\xef\x82\x84'
readonly ICON_LOCK=$'\xef\x80\xa3'
readonly ICON_PROFILE=$'\xef\x8a\xbd'
readonly ICON_UNLOCK=$'\xef\x82\x9c'
readonly ICON_WARNING=$'\xef\x81\xb1'

readonly -a ICONS_LOADING=(
  $'\xf3\xb0\xaa\x9e'
  $'\xf3\xb0\xaa\x9f'
  $'\xf3\xb0\xaa\xa0'
  $'\xf3\xb0\xaa\xa1'
  $'\xf3\xb0\xaa\xa2'
  $'\xf3\xb0\xaa\xa3'
  $'\xf3\xb0\xaa\xa4'
  $'\xf3\xb0\xaa\xa5'
)

readonly PROFILE_CONFIG_FILE="$HOME/.config/dotfiles/profiles.zsh"

if [[ ! -r "$PROFILE_CONFIG_FILE" ]]; then
  print -u2 -r -- "Missing profile configuration: ${PROFILE_CONFIG_FILE}. Run chezmoi apply."
  exit 1
fi

source "$PROFILE_CONFIG_FILE" || exit 1

function status_success() {
  print -P -r -- "%F{green}${1}%f ${2}"
}

function status_warning() {
  print -u2 -P -r -- "%F{yellow}${ICON_WARNING}%f ${1}"
}

function status_error() {
  print -u2 -P -r -- "%F{red}${ICON_ERROR}%f ${1}"
}

function run_with_loading() {
  local message="$1"
  shift

  if [[ ! -t 1 ]]; then
    "$@"
    return $?
  fi

  local output_file process_id result
  local index=1

  output_file="$(mktemp "${TMPDIR:-/tmp}/auth.XXXXXX")" || return 1
  "$@" >"$output_file" 2>&1 &
  process_id=$!

  while kill -0 "$process_id" 2>/dev/null; do
    print -n -P -r -- $'\r\e[2K'"%F{yellow}${ICONS_LOADING[index]}%f ${message}"
    (( index = index % ${#ICONS_LOADING} + 1 ))
    sleep 0.2
  done

  wait "$process_id"
  result=$?
  print -n -r -- $'\r\e[2K'
  [[ ! -s "$output_file" ]] || command cat -- "$output_file"
  command rm -f -- "$output_file"
  return "$result"
}

function run_quiet() {
  local output line

  output="$("$@" 2>&1)" && return 0
  for line in ${(f)output}; do
    status_error "$line"
  done
  return 1
}

function usage() {
  local -a profile_ids

  profile_ids=("${(@f)$(configured_profile_ids)}")
  print -r -- "Usage: auth [${(j:|:)profile_ids}|unlock|lock]"
  print -r -- ''
  print -r -- 'Load credentials, unlock Proton Pass, or remove loaded credentials.'
  print -r -- "The default profile is ${DEFAULT_PROFILE}."
}

function configured_profile_ids() {
  local key profile
  local -a profiles

  for key in "${(@k)PROFILE_CONFIG}"; do
    [[ "$key" == *.name ]] || continue
    profile="${key%.name}"
    [[ "$profile" == "$DEFAULT_PROFILE" ]] || profiles+=("$profile")
  done

  if [[ -n "${PROFILE_CONFIG[${DEFAULT_PROFILE}.name]-}" ]]; then
    print -r -- "$DEFAULT_PROFILE"
  fi
  (( ${#profiles} == 0 )) || print -rl -- ${(on)profiles}
}

function profile_exists() {
  local key="${1}.name"

  [[ -n "${PROFILE_CONFIG[$key]-}" ]]
}

function validate_profile_config() {
  local profile="$1" field key
  local -a required_fields=(name vault_name gpg_key_name)

  for field in "${required_fields[@]}"; do
    key="${profile}.${field}"
    if [[ -z "${PROFILE_CONFIG[$key]-}" ]]; then
      status_error "Profile ${profile} is missing ${field}. Check .chezmoidata/profiles.toml and run chezmoi apply."
      return 1
    fi
  done
}

function require_commands() {
  local dependency

  for dependency in "$@"; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
      status_error "Missing ${dependency}. Run brew bundle --file=\"$HOME/.Brewfile\"."
      return 1
    fi
  done
}

function key_fingerprint() {
  gpg --batch --with-colons --import-options show-only --import \
    | awk -F: '
        $1 == "pub" || $1 == "sec" { primary=1; count++; next }
        $1 == "fpr" && primary { fingerprint=$10; primary=0 }
        END { if (count == 1 && fingerprint != "") print fingerprint; else exit 1 }
      '
}

function command_version() {
  "$1" --version 2>/dev/null | awk 'NR == 1 { print $3; exit }'
}

function running_gpg_agent_version() {
  gpg-connect-agent 'GETINFO version' /bye 2>/dev/null \
    | awk '$1 == "D" { print $2; exit }'
}

function stop_systemd_gpg_agent() {
  local unit
  local -a active_units units

  command -v systemctl >/dev/null 2>&1 || return 0
  units=(
    gpg-agent.service
    gpg-agent.socket
    gpg-agent-browser.socket
    gpg-agent-extra.socket
    gpg-agent-ssh.socket
  )

  for unit in "${units[@]}"; do
    if systemctl --user --quiet is-active "$unit" >/dev/null 2>&1; then
      active_units+=("$unit")
    fi
  done

  (( ${#active_units} == 0 )) || run_quiet systemctl --user stop "${active_units[@]}"
}

function ensure_gpg_agent() {
  local gpg_version gpgconf_version agent_version

  gpg_version="$(command_version gpg)" || return 1
  gpgconf_version="$(command_version gpgconf)" || return 1
  if [[ -z "$gpg_version" || -z "$gpgconf_version" ]]; then
    status_error 'Unable to determine the installed GnuPG version.'
    return 1
  fi
  if [[ "$gpg_version" != "$gpgconf_version" ]]; then
    status_error "gpg ${gpg_version} and gpgconf ${gpgconf_version} come from different installations."
    return 1
  fi

  run_quiet gpgconf --launch gpg-agent || return 1
  agent_version="$(running_gpg_agent_version)"
  [[ "$agent_version" == "$gpg_version" ]] && return 0

  if [[ -n "$agent_version" ]]; then
    status_warning "Replacing gpg-agent ${agent_version} with ${gpg_version}."
  fi
  stop_systemd_gpg_agent || return 1
  run_quiet gpgconf --kill gpg-agent || return 1
  run_quiet gpgconf --launch gpg-agent || return 1

  agent_version="$(running_gpg_agent_version)"
  if [[ "$agent_version" != "$gpg_version" ]]; then
    status_error "gpg-agent ${agent_version:-unknown} does not match gpg ${gpg_version}."
    return 1
  fi
}

function cache_gpg_key() {
  local fingerprint="$1" item_uri="$2"
  local libexec_dir preset_passphrase key_data keygrips keygrip

  libexec_dir="$(gpgconf --list-dirs libexecdir)" || return 1
  preset_passphrase="${libexec_dir}/gpg-preset-passphrase"
  if [[ ! -x "$preset_passphrase" ]]; then
    status_error "gpg-preset-passphrase not found at ${preset_passphrase}."
    return 1
  fi

  key_data="$(gpg --batch --with-colons --with-keygrip --list-secret-keys "$fingerprint")" || return 1
  keygrips="$(print -r -- "$key_data" | awk -F: '
    $1 == "sec" || $1 == "ssb" { available=($15 == "+") }
    $1 == "grp" && available { print $10 }
  ')" || return 1
  if [[ -z "$keygrips" ]]; then
    status_error "No local secret key material found for ${fingerprint}."
    return 1
  fi

  for keygrip in ${(f)keygrips}; do
    pass-cli item view "${item_uri}/passphrase" \
      | "$preset_passphrase" --preset "$keygrip" || return 1
  done
}

function load_gpg_key() {
  local vault_name="$1" key_name="$2"
  local item_uri="pass://${vault_name}/${key_name}"
  local key_id public_key private_key fingerprint private_fingerprint

  key_id="$(pass-cli item view "${item_uri}/Key ID")" || return 1
  key_id="${(U)key_id}"
  key_id="${key_id#0X}"
  if [[ "$key_id" == *[^0-9A-F]* ]] || \
      (( ${#key_id} != 16 && ${#key_id} != 40 && ${#key_id} != 64 )); then
    status_error "${key_name}: Key ID must be a 16-digit key ID or full primary fingerprint."
    return 1
  fi

  public_key="$(pass-cli item view "${item_uri}/public_key")" || return 1
  fingerprint="$(print -r -- "$public_key" | key_fingerprint)" || return 1
  if [[ "$fingerprint" != "$key_id" && \
        ! ( ${#key_id} == 16 && "$fingerprint" == *"$key_id" ) ]]; then
    status_error "${key_name}: public key does not match its Key ID."
    return 1
  fi

  private_key="$(pass-cli item view "${item_uri}/private_key")" || return 1
  private_fingerprint="$(print -r -- "$private_key" | key_fingerprint)" || return 1
  if [[ "$private_fingerprint" != "$fingerprint" ]]; then
    status_error "${key_name}: private and public keys do not match."
    return 1
  fi

  print -r -- "$public_key" | run_quiet gpg --batch --import || return 1
  print -r -- "$private_key" | run_quiet gpg --batch --import || return 1
  private_key=

  cache_gpg_key "$fingerprint" "$item_uri" || return 1

  if ! print -r -- 'dotfiles auth signing check' \
      | run_quiet gpg --batch --yes --pinentry-mode error --local-user "$fingerprint" \
          --output /dev/null --detach-sign; then
    status_error "${key_name}: signing check failed. Verify the key and passphrase in Proton Pass."
    return 1
  fi

  print -r -- "${fingerprint}:6:" | run_quiet gpg --batch --import-ownertrust || return 1
  status_success "$ICON_KEY" "GPG key loaded: ${key_name}."
}

function start_ssh_agent() {
  local agent_env

  agent_env="$(keychain agent start --quiet --no-inherit --eval --host "${SHORT_HOST:-${(%):-%m}}")" || return 1
  eval "$agent_env"
}

# Return 2 when the session has no lock and 3 when it needs a login.
function lock_pass() {
  local output normalized_output

  output="$(pass-cli session lock 2>&1)" && {
    return 0
  }
  normalized_output="${(L)output}"

  if [[ "$output" == *SessionLocked* ]]; then
    return 0
  fi

  if [[ "$output" == *"Session has no lock."* ]]; then
    return 2
  fi

  if [[ "$normalized_output" == *"pass-cli login"* ||
        "$normalized_output" == *"there is no session"* ||
        "$normalized_output" == *"requires an authenticated client"* ]]; then
    return 3
  fi

  if [[ -n "$output" ]]; then
    local line
    for line in ${(f)output}; do
      status_error "$line"
    done
  fi
  return 1
}

function unlock_pass() {
  local lock_status

  lock_pass
  lock_status=$?

  case "$lock_status" in
    # Keep stderr attached to the terminal for lock-code prompts.
    0) pass-cli session unlock >/dev/null ;;
    2) pass-cli session create-lock >/dev/null ;;
    3) pass-cli login && pass-cli session create-lock >/dev/null ;;
    *) return "$lock_status" ;;
  esac
}

function ensure_pass_locked() {
  local lock_status

  lock_pass
  lock_status=$?

  case "$lock_status" in
    0) return 0 ;;
    2) status_warning 'Proton Pass has no session lock. Run auth to create one.' ;;
    3) status_warning 'Proton Pass is logged out. Run auth to sign in.' ;;
  esac
  return "$lock_status"
}

function unlock_session() {
  require_commands pass-cli || return 1
  unlock_pass || return 1
  status_success "$ICON_UNLOCK" 'Proton Pass unlocked.'
}

function load_credentials() {
  local profile="$1" result=0
  local profile_name vault_name gpg_key_name

  validate_profile_config "$profile" || return 1
  profile_name="${PROFILE_CONFIG[${profile}.name]}"
  vault_name="${PROFILE_CONFIG[${profile}.vault_name]}"
  gpg_key_name="${PROFILE_CONFIG[${profile}.gpg_key_name]}"

  require_commands pass-cli keychain ssh-add gpg gpgconf gpg-connect-agent awk || return 1
  start_ssh_agent || return 1
  ensure_gpg_agent || return 1

  {
    if unlock_pass; then
      status_success "$ICON_UNLOCK" 'Proton Pass unlocked.'
      if run_with_loading 'Loading SSH keys...' \
          run_quiet pass-cli ssh-agent load --vault-name "$vault_name"; then
        status_success "$ICON_KEY" "SSH keys loaded: ${vault_name}."
      else
        result=1
      fi
      run_with_loading 'Loading GPG key...' \
        load_gpg_key "$vault_name" "$gpg_key_name" || result=1
    else
      result=1
    fi
  } always {
    if ensure_pass_locked; then
      status_success "$ICON_LOCK" 'Proton Pass locked.'
    else
      result=1
    fi
  }

  if (( result == 0 )); then
    status_success "$ICON_PROFILE" "Credentials ready: ${profile_name}."
  else
    status_warning 'Authentication was incomplete. Some keys may already be loaded.'
  fi
  return "$result"
}

function lock_credentials() {
  local result=0

  require_commands pass-cli keychain ssh-add gpgconf || return 1
  if start_ssh_agent; then
    if run_quiet ssh-add -D; then
      status_success "$ICON_KEY" 'SSH keys removed.'
    else
      result=1
    fi
  else
    result=1
  fi
  if run_quiet gpgconf --reload gpg-agent; then
    status_success "$ICON_KEY" 'GPG passphrases cleared.'
  else
    result=1
  fi
  if ensure_pass_locked; then
    status_success "$ICON_LOCK" 'Proton Pass locked.'
  else
    result=1
  fi

  if (( result == 0 )); then
    status_success "$ICON_PROFILE" 'Credentials cleared.'
  fi
  return "$result"
}

function main() {
  local command="${1:-$DEFAULT_PROFILE}"

  if (( $# > 1 )); then
    usage >&2
    return 2
  fi

  case "$command" in
    unlock) unlock_session ;;
    lock) lock_credentials ;;
    -h|--help|help) usage ;;
    *)
      if profile_exists "$command"; then
        load_credentials "$command"
      else
        status_error "Unknown command: ${command}"
        usage >&2
        return 2
      fi
      ;;
  esac
}

main "$@"
