{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-models-discovery@latest"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "ask"
  },
  "provider": {
    "local": {
      "name": "Local Models",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llms.danielwaltz.net/v1",
        "modelsDiscovery": {
          "enabled": true
        }
      }
    }
  }
}
