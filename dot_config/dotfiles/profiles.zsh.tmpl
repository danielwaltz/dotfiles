{{- $config := includeTemplate "profile-data" . | fromJson -}}
# Generated from .chezmoidata/profiles.toml and .chezmoidata/hosts.toml. Edit the source, then run chezmoi apply.
# Other Zsh scripts can source this file to read the resolved profile settings.
typeset -gr DEFAULT_PROFILE={{ $config.default_profile | shellQuote }}
typeset -grA PROFILE_CONFIG=(
{{- range $id, $profile := $config.profiles }}
{{- range $field, $value := $profile }}
  {{ printf "%s.%s" $id $field | shellQuote }} {{ $value | shellQuote }}
{{- end }}
{{- end }}
)

function _dotfiles_current_profile() {
  emulate -L zsh
  local profile="$DEFAULT_PROFILE" key candidate directory
  local current_directory="${PWD:A}" matched_length=0

  for key in "${(@k)PROFILE_CONFIG}"; do
    [[ "$key" == *.directory ]] || continue
    candidate="${key%.directory}"
    directory="${PROFILE_CONFIG[$key]}"
    directory="${directory:A}"
    if [[ "$current_directory" == "$directory" ||
          "$current_directory" == "${directory%/}/"* ]]; then
      if (( ${#directory} > matched_length )); then
        profile="$candidate"
        matched_length=${#directory}
      fi
    fi
  done

  print -r -- "$profile"
}

{{- $hosts := includeTemplate "host-data" . | fromJson }}
typeset -grA HOST_CONFIG=(
{{- range $host, $profile := $hosts }}
{{- range $field, $value := $profile }}
  {{ printf "%s.%s" $host $field | shellQuote }} {{ $value | shellQuote }}
{{- end }}
{{- end }}
)
