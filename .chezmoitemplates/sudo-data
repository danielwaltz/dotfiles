{{- $config := includeTemplate "profile-data" . | fromJson -}}
{{- $hosts := includeTemplate "host-data" . | fromJson -}}
{{- $resolved := dict -}}
{{- range $id, $profile := $config.profiles -}}
  {{- if regexMatch "/" $profile.vault_name -}}
    {{- fail (printf "profiles.toml: profiles.%s vault name must contain no slashes for sudo references" $id) -}}
  {{- end -}}
{{- end -}}
{{- range $host, $settings := $hosts -}}
  {{- $shortHost := get $hosts (first (splitList "." $host)) | default dict -}}
  {{- $id := get $settings "default_profile" | default (get $shortHost "default_profile") | default $.profiles.defaults.default_profile -}}
  {{- $_ := set $resolved $host (get $config.profiles $id).vault_name -}}
{{- end -}}
{{- $default := get $config.profiles $.profiles.defaults.default_profile -}}
{{- dict "hosts" $resolved "default_vault" $default.vault_name | toJson -}}
