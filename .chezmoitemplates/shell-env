export PATH="$HOME/.local/bin:$PATH"
export EDITOR="vim"
export VISUAL=$EDITOR

[[ -t 0 ]] && export GPG_TTY="$TTY"

{{- if eq .chezmoi.os "linux" }}
export LANG="${LANG:-C.UTF-8}"

if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && {
  { command -v gdbus >/dev/null 2>&1 &&
    gdbus call --session --timeout 1 \
      --dest org.freedesktop.secrets \
      --object-path /org/freedesktop/secrets \
      --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; } ||
  { command -v busctl >/dev/null 2>&1 &&
    busctl --user --quiet --timeout=1s call \
      org.freedesktop.secrets /org/freedesktop/secrets \
      org.freedesktop.DBus.Peer Ping >/dev/null 2>&1; } ||
  { command -v dbus-send >/dev/null 2>&1 &&
    dbus-send --session --print-reply --reply-timeout=1000 \
      --dest=org.freedesktop.secrets /org/freedesktop/secrets \
      org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; }
}; then
  export PROTON_PASS_LINUX_KEYRING=dbus
else
  unset PROTON_PASS_LINUX_KEYRING
fi
{{- end }}

# ---- sudo askpass (Proton Pass / pass-cli) ----------------------------------
# Probe `pass-cli` install locations (capability probes only, no OS
# detection) so the askpass flow is available from any shell, not just the
# interactive zsh wrapper in ~/.zshrc. When `pass-cli` cannot be resolved,
# or ~/.local/bin/sudo-askpass is missing, SUDO_ASKPASS is left unset and
# sudo falls back to the ordinary terminal prompt.
if [ -z "${SUDO_ASKPASS:-}" ] && [ -x "$HOME/.local/bin/sudo-askpass" ]; then
  _dotfiles_pass_cli=''
  for _dotfiles_candidate in \
    "$(command -v pass-cli 2>/dev/null)" \
    "${HOMEBREW_PREFIX:-}/bin/pass-cli" \
    /opt/homebrew/bin/pass-cli \
    /usr/local/bin/pass-cli \
    "$HOME/.local/bin/pass-cli" \
    "$HOME/.linuxbrew/bin/pass-cli" \
    /home/linuxbrew/.linuxbrew/bin/pass-cli
  do
    [ -n "$_dotfiles_candidate" ] && [ -x "$_dotfiles_candidate" ] || continue
    "$_dotfiles_candidate" --version >/dev/null 2>&1 || continue
    _dotfiles_pass_cli="$_dotfiles_candidate"
    break
  done
  unset _dotfiles_candidate
  if [ -n "$_dotfiles_pass_cli" ]; then
    SUDO_ASKPASS="$HOME/.local/bin/sudo-askpass"
    export SUDO_ASKPASS
  fi
  unset _dotfiles_pass_cli
fi
